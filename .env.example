# Copy to .env for local development. Never commit the filled-in file.

# --- Database ---------------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Defaults to "require". Only ever "disable" against a local database.
DB_SSLMODE=require

# --- Auth -------------------------------------------------------------------
JWT_SECRET=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# --- Web app ----------------------------------------------------------------
# Browsers calling the API cross-origin, comma separated. Not needed in
# production, where the web app is served from this same origin. In development
# `next dev` runs on another port, so it is: http://localhost:3000
ALLOWED_ORIGINS=

# --- Error reporting (optional) ---------------------------------------------
# Server-side. Leave blank and reporting stays off; nothing else changes.
SENTRY_DSN=
ENVIRONMENT=development
RELEASE_VERSION=

# The browser DSN is compiled into the web bundle, so it is a *build* argument,
# not a runtime variable — set it on the Docker build, not here:
#   NEXT_PUBLIC_SENTRY_DSN, NEXT_PUBLIC_SENTRY_ENV, NEXT_PUBLIC_RELEASE

# --- Push notifications (APNs) ----------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_BASE64=
APNS_PRODUCTION=false

# --- Migrations -------------------------------------------------------------
# Migrations run on boot unless this is exactly "false".
RUN_MIGRATIONS=true
