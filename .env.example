DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=
JWT_SECRET=
SERVER_PORT=
LOG_LEVEL=
RESEND_API_KEY=
EMAIL_FROM=

# Comma-separated list of allowed browser origins for CORS.
# Not needed for the mobile app (it doesn't send an Origin header) — only
# set this if a web client calls the API directly from the browser.
ALLOWED_ORIGINS=

# Set to "production" on the live server. When set, JWT_SECRET, DB_USER and
# DB_PASSWORD are required — the server refuses to start without them
# instead of silently falling back to an insecure default.
ENVIRONMENT=development
